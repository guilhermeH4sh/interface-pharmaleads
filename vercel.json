{
  "installCommand": "npm ci --prefix apps/web",
  "buildCommand": "npm --prefix apps/web run build",
  "outputDirectory": "apps/web/dist",
  "redirects": [{ "source": "/prospeccao", "destination": "/leads", "permanent": true }],
  "rewrites": [{ "source": "/leads", "destination": "/index.html" }],
  "functions": {
    "api/collector.mjs": {
      "includeFiles": "api/cobertura_nacional.json"
    }
  }
}
