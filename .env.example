# M01: configurar estas variáveis no processo PowerShell.
# Não carregar automaticamente .env/.env.local do legado.
PHARMALEADS_APP_ENV=development
PHARMALEADS_APP_HOST=127.0.0.1
PHARMALEADS_APP_PORT=8000
PHARMALEADS_ALLOWED_ORIGINS=["http://localhost:5173"]

# M02: documentação somente; definir no processo, não enviar valores reais no chat.
# Projeto autorizado: qxsdcrywsjkrpcbfgbxb; uso inicial somente public.pharmaleads.
# Para prova read-only, prefira ops/windows/Test-Supabase-Connection.ps1.
# O script solicita a senha no terminal e configura TLS sem persistir a URL.

# Data API escolhida para a conexão inicial M02 (somente HEAD de public.pharmaleads).
# Use exclusivamente chave publicável sb_publishable_... via variável de processo.
# Não use chave secret/service_role. Inicie com Start-Api.ps1 -ConnectSupabase.
# PHARMALEADS_DATA_API_PUBLISHABLE_KEY=sb_publishable_COLE_LOCALMENTE
# Passo 1 M02: escrita CSV bloqueada por padrão; não ativar antes de corrigir RLS.
# PHARMALEADS_TABLE_WRITE_APPROVED=public.pharmaleads
# Sem configuração de banco, a API M01 continua iniciando sem conexão automática.
# PHARMALEADS_DB_ENVIRONMENT=development
# PHARMALEADS_DB_URL=postgresql+psycopg://MIGRATION_LOGIN:SENHA_CODIFICADA@db.PROJECT_REF.supabase.co:5432/postgres
# PHARMALEADS_DB_TARGET_HOST=db.PROJECT_REF.supabase.co
# PHARMALEADS_DB_TARGET_DATABASE=postgres
# PHARMALEADS_DB_PROJECT_REF=PROJECT_REF
# PHARMALEADS_DB_CONNECTION_MODE=direct
# PHARMALEADS_DB_SSLROOTCERT=C:/caminho/certificado-raiz.crt
# PHARMALEADS_DB_POOL_SIZE=2
# PHARMALEADS_DB_LOCAL_TEST=false
